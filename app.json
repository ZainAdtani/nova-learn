{
  "expo": {
    "name": "Nova Learn",
    "slug": "nova-learn",
    "version": "0.1.0",
    "scheme": "novalearn",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0F1A",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adtaniedu.supernova",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-iap",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "70053182-a159-4b93-842a-383a6b18c9ac"
      }
    },
    "owner": "zainadtani",
    "newArchEnabled": true
  }
}
