{
  "expo": {
    "name": "Nova Learn",
    "slug": "supernova-app",
    "version": "0.1.0",
    "scheme": "novalearn",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0F1A",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adtaniedu.supernova",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-iap",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "70053182-a159-4b93-842a-383a6b18c9ac"
      }
    },
    "owner": "zainadtanis-team"
  }
}
